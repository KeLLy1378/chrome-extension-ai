{
  "manifest_version": 3,
  "name": "Simply: Упрощение текста",
  "version": "1.0.3",
  "description": "Упрощение текста с помощью ИИ.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "Simply",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
    "matches": ["https://*/*"],
    "js": ["content-script.js"],
    "css": ["overlay.css"]
    }
  ]
  ,
  "web_accessible_resources": [
    {
      "resources": ["overlay.css"],
      "matches": ["<all_urls>"]
    }
  ]
}