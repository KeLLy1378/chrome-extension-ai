{
  "manifest_version": 3,
  "name": "Адаптация сложности текста",
  "version": "1.0.0",
  "description": "Адаптация сложности текста с помощью ИИ.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "Адаптация сложности текста",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
    "matches": ["https://*/*"],
    "js": ["content-script.js"]
    }
  ]
}